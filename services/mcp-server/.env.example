# Copy this file to .env before running the server directly:
#   cp .env.example .env
#
# This server reads these as real process environment variables — set them
# however your MCP client (e.g. Claude Code's MCP server config) launches
# the process, or `set -a; source .env; set +a` before running it manually.

# --- Platform API ---
# Optional once this machine has signed in: `company-deploy login --url ...`
# remembers the address in the credentials file.
PLATFORM_API_BASE_URL=http://localhost:8090
PLATFORM_API_TIMEOUT_SECONDS=120

# --- Who this server acts for ---
# Not configured here. The machine signs in once (the `login` tool, or
# `company-deploy login`) and an employee approves it in the Admin Portal;
# the API key it receives is stored in the file below. See README.md,
# "Signing a machine in".
#COMPANY_DEPLOY_CREDENTIALS=~/.company-deploy/credentials.json

# --- Idempotency (best-effort, non-durable — see idempotency.py) ---
MCP_IDEMPOTENCY_TTL_SECONDS=86400
