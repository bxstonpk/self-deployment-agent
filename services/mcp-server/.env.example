# Copy this file to .env before running the server directly:
#   cp .env.example .env
#
# This server reads these as real process environment variables — set them
# however your MCP client (e.g. Claude Code's MCP server config) launches
# the process, or `set -a; source .env; set +a` before running it manually.

# --- Platform API ---
PLATFORM_API_BASE_URL=http://localhost:8090
PLATFORM_API_TIMEOUT_SECONDS=30

# --- Dev-mode identity (temporary — see DEC-003, docs/17_Decision_Log.md) ---
# This server acts on behalf of exactly ONE employee identity for its whole
# process lifetime — see src/mcp_server/config.py's doc comment for why.
# MCP_ENV must be "dev"; the server refuses to start under any other value
# until real per-call MCP session-token authentication exists.
MCP_ENV=dev
MCP_EMPLOYEE_EMAIL=alice@example.com
MCP_EMPLOYEE_NAME=Alice Employee
MCP_EMPLOYEE_DEPARTMENT=Engineering

# --- Idempotency (best-effort, non-durable — see idempotency.py) ---
MCP_IDEMPOTENCY_TTL_SECONDS=86400
