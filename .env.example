# Copy this file to .env before running `docker compose up`:
#   cp .env.example .env
#
# .env is git-ignored (see .gitignore) — real values live only on your
# machine, never in source control. This file is a template, not a secret;
# do not put real credentials here.

# --- Postgres (services/platform-api, local dev only) ---
# Any values are fine for local development — this database is only
# reachable from inside the docker compose network. Do NOT reuse these for
# any shared/staging/production environment (see DEC-004, DEC-006 in
# docs/17_Decision_Log.md for how those will actually be provisioned).
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=platform

# --- Host port mappings ---
# Change these if the defaults collide with another project's containers
# on your machine.
POSTGRES_HOST_PORT=5436
# On a LAN host, bind the API to loopback (PLATFORM_API_HOST_PORT=127.0.0.1:8090):
# Docker-published ports bypass ufw, and the LAN should reach the API only
# through the gateway's /api/.
PLATFORM_API_HOST_PORT=8090
# The gateway: the one address employees and their Claude Code machines use
# (Admin Portal, /api/, /run/, /downloads/). See docs/LAN_Deployment_Standard.md.
GATEWAY_HOST_PORT=8080

# --- Platform API ---
PLATFORM_ENV=dev

# --- Authentication (DEC-001/DEC-003 revised 2026-10-23) ---
# "token" (default): employees register and sign in with a password; each
# Claude Code machine fetches its own API key through a device approval
# before it can deploy. "dev-header" is the old self-declared identity,
# for local test scripts only, and is refused unless PLATFORM_ENV=dev.
PLATFORM_AUTH_MODE=token

# The shared code IT gives employees so they can create an account — the
# thing that stops anyone on the LAN from registering. At least 8
# characters; required in token mode. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(12))"
# Changing it doesn't affect existing accounts.
PLATFORM_ENROLLMENT_CODE=

# Optional: only these email domains may register (comma-separated).
#PLATFORM_ALLOWED_EMAIL_DOMAINS=sti-th.com

# Where employees open the Admin Portal; a machine asking for a key is
# told to approve it at {PLATFORM_PORTAL_URL}/device. Through the gateway
# that's its address (e.g. http://platform-host:8080); the Vite dev
# server's is http://localhost:5173.
PLATFORM_PORTAL_URL=http://localhost:5173

# Lifetimes, in seconds: a Portal session (12h), a machine's API key
# (30 days), and the longest an employee may ask for when issuing one by
# hand (90 days). Engineering defaults, not ratified policy.
SESSION_TTL_SECONDS=43200
API_KEY_TTL_SECONDS=2592000
API_KEY_MAX_TTL_SECONDS=7776000

# Origins allowed to call the Platform API from a browser (apps/admin-portal,
# Vite's default dev-server port below). Comma-separated; leave empty to
# disable CORS entirely (e.g. if you're not running the admin portal).
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Scale-to-Zero (Module L, FR-052) ---
# Per FR-052's business rule, the idle threshold is a platform-defined
# default (exact value TBD — see docs/17_Decision_Log.md), NOT an
# employee-configurable deployment.yaml field. 300s/30s below are
# reasonable defaults for local dev; lower them temporarily if you want to
# observe a real scale-down without waiting minutes (e.g. 20 / 5).
SCALE_TO_ZERO_IDLE_SECONDS=300
SCALE_SWEEP_INTERVAL_SECONDS=30

# --- Application URLs ---
# Where this API is reachable from outside its container, which is where
# a deployed application's own URL comes from:
# {PLATFORM_PUBLIC_BASE_URL}/run/{application}/{service}. Defaults to
# http://localhost:PLATFORM_API_HOST_PORT, so it only needs setting if the
# platform sits behind a different host or a reverse proxy.
#PLATFORM_PUBLIC_BASE_URL=http://localhost:8090
# On the LAN host, set it to the gateway's address as other machines reach
# it, e.g. http://platform-host:8080 (and PLATFORM_PORTAL_URL to the same).

# --- Log retention (Module S, FR-088) ---
# Application logs older than this are deleted hourly: 90 days, decided in
# DEC-027 (docs/17_Decision_Log.md). 0 keeps them forever.
LOG_RETENTION_DAYS=90

# --- Database backups (FR-064, DEC-025) ---
# A full backup every BACKUP_FULL_WEEKDAY, a differential (what changed
# since that full) every other day, each starting from BACKUP_HOUR local to
# BACKUP_TIMEZONE. Once a new full succeeds the previous week's backups are
# deleted. An application opts out with `database: backup: none` in its
# deployment.yaml. Files are sealed with PLATFORM_SECRET_KEY and kept in the
# platform-backups volume.
BACKUP_ENABLED=true
BACKUP_HOUR=1
BACKUP_TIMEZONE=Asia/Bangkok
BACKUP_FULL_WEEKDAY=sunday

# --- Platform administrators ---
# Account emails (comma-separated) that receive platform-level alerts, such
# as the host disk filling up. They must register like anyone else.
PLATFORM_ADMIN_EMAILS=

# --- Signed approvals (DEC-017) ---
# The platform administrators' Ed25519 public keys, as `company-deploy
# approver keygen` prints them: email=ed25519:<base64>, comma-separated.
# With any set, a deployment needing approval goes ahead only on a decision
# signed with the matching private key (`company-deploy approve`), which
# never leaves the administrator's machine. Left empty, an application's
# own owner approves, as before.
PLATFORM_APPROVER_KEYS=
# Which environments' deployments need approval: production, or
# production,dev to review every deployment.
APPROVAL_REQUIRED_ENVIRONMENTS=production

# --- Development governance ---
# A build refuses an application with no profile (what it is for, who uses
# it, whether it handles personal data), which start_project records.
# false turns that off, e.g. for the older verify scripts.
GOVERNANCE_REQUIRE_PROFILE=true

# --- Alerts (FR-092, DEC-028) ---
# Announced once when an alert starts, once if it becomes critical, at most
# once an hour while it lasts, and once when it clears, in the owners'
# notification inbox (platform-level alerts go to PLATFORM_ADMIN_EMAILS).
# Defaults are the decided set ("B"); uncomment to override.
#ALERT_ERROR_RATE_WARNING_PERCENT=5     # 5xx share over the traffic window,
#ALERT_ERROR_RATE_CRITICAL_PERCENT=20   #   judged only from ALERT_MIN_REQUESTS
#ALERT_MIN_REQUESTS=20
#ALERT_LATENCY_WARNING_MS=1000          # mean response time
#ALERT_LATENCY_CRITICAL_MS=3000
#ALERT_TRAFFIC_WINDOW_SECONDS=300
#ALERT_CPU_WARNING_PERCENT=85           # sustained over the whole CPU window
#ALERT_CPU_CRITICAL_PERCENT=95
#ALERT_CPU_WINDOW_SECONDS=600
#ALERT_MEMORY_WARNING_PERCENT=80        # of the container's limit (the host's RAM: no quotas)
#ALERT_MEMORY_CRITICAL_PERCENT=95
#ALERT_MEMORY_WINDOW_SECONDS=300
#ALERT_DISK_WARNING_PERCENT=85          # the host's data disk
#ALERT_DISK_CRITICAL_PERCENT=95
#ALERT_REMINDER_SECONDS=3600
#ALERT_EVAL_INTERVAL_SECONDS=60

# --- Monitoring (Module T, FR-090) ---
# How often the platform reads each running container's CPU and memory.
# An engineering default rather than a policy value: nothing in the
# requirements sets a sampling rate. Lower it (e.g. 5) to watch the
# numbers move without waiting. Nothing is purged at any interval —
# NFR-032's retention durations are still TBD.
METRICS_SAMPLE_INTERVAL_SECONDS=15

# --- Continuous Health Monitoring (Module R, FR-084/085) ---
# How often the platform re-checks every already-Running instance's health,
# on top of the checks already run at deploy/resume/restart/cold-start. An
# engineering default, same status as METRICS_SAMPLE_INTERVAL_SECONDS above
# — nothing in the requirements sets this rate. Lower it (e.g. 3) to watch
# a simulated failure get detected and remediated without waiting.
HEALTH_SWEEP_INTERVAL_SECONDS=15

# --- Automatic Rollback (Module V, FR-099) ---
# How long after a deployment reaches Running its own health-check
# exhaustion is treated as "this version regressed" (triggering an
# automatic rollback to the last known-good version) rather than "an
# established instance flaked" (Module R's existing restart-in-place/
# escalate handling). An engineering default, same status as the interval
# above — nothing in the requirements sets this window. Lower it (e.g. 20)
# to watch a simulated bad deploy get rolled back without waiting minutes.
POST_ACTIVATION_ROLLBACK_WINDOW_SECONDS=300

# --- Ownership Transfer (Module E, FR-016) ---
# The "policy window" a nominated new owner has to accept a transfer
# before it expires — exact value TBD (docs/17_Decision_Log.md), same
# "reasonable default, not a ratified value" status as the scale-to-zero
# timeouts above. Default is 7 days; lower it temporarily to observe a
# real expiry without waiting a week (e.g. 5).
OWNERSHIP_TRANSFER_WINDOW_SECONDS=604800

# --- Secret Management (Module O, FR-066) ---
# The key the platform encrypts every stored secret with: application
# secrets, and the database passwords it generates. 32 random bytes,
# base64-encoded. Generate one with either of:
#   openssl rand -base64 32
#   python -c "import base64, os; print(base64.b64encode(os.urandom(32)).decode())"
# Required: left empty, docker compose refuses to start the platform
# rather than let it store secrets it can't encrypt. On the platform host,
# seal it with the TPM instead and leave this empty: see
# deploy/host/README.md (DEC-006). Changing it later
# makes every stored secret unreadable — applications then fail to start
# rather than start without their credentials — and there is no
# re-encryption tool yet. Never commit a real value.
PLATFORM_SECRET_KEY=
