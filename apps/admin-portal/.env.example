# Copy to .env.local before running `npm run dev`:
#   cp .env.example .env.local
# .env.local is git-ignored (see repo root .gitignore).

# Where the Platform API is reachable from your browser. Matches
# docker-compose.yml's PLATFORM_API_HOST_PORT default (8090) at the repo
# root. The Platform API must have this app's origin
# (http://localhost:5173, Vite's default) in its own CORS_ALLOWED_ORIGINS —
# see the repo root .env.example.
VITE_PLATFORM_API_BASE_URL=http://localhost:8090
